# Copiar a .env y reemplazar cada valor (genera claves con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))")
SECMON_ADMIN_CLAVE=cambia-esta-clave
SECMON_COLECTOR_CLAVE=cambia-esta-clave
SECMON_LECTURA_CLAVE=cambia-esta-clave
SECMON_DOMINIO=ethosia.tech
SECMON_INTERVALO_MIN=30
# Opcional: publicar el resumen en el panel del sitio (misma clave que SECMON_INGEST_KEY en Vercel)
SECMON_PANEL_URL=https://www.ethosia.tech/api/seguridad/reporte
SECMON_INGEST_KEY=
