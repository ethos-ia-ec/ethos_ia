# Cascada de IA compartida (Groq → OpenRouter → NVIDIA) — usada por /api/empresa-chat
# y también por el bot de WhatsApp (que llama a este mismo endpoint, no a los
# proveedores directamente). Deben ser LAS MISMAS credenciales que uses en el bot,
# para que compartan la cuota diaria en vez de competir por el mismo cupo gratuito.
GROQ_API_KEY=tu_clave_de_groq_aqui
OPENROUTER_API_KEY=tu_clave_de_openrouter_aqui
NVIDIA_API_KEY=tu_clave_de_nvidia_aqui
GROQ_DAILY_LIMIT=500
OPENROUTER_DAILY_LIMIT=45
NVIDIA_DAILY_LIMIT=300

# Opcional: URL de un webhook (Slack incoming webhook, Discord, o cualquier
# endpoint que acepte { "text": "..." } por POST) para avisar cuando algún
# proveedor de IA llega al 80% de su cupo diario. Sin esta variable, la
# cascada sigue funcionando igual, solo que nadie se entera hasta que el
# proveedor se agota del todo.
ALERT_WEBHOOK_URL=

# Supabase — guarda la cuota diaria de IA (tabla ia_uso_diario) y los leads del
# formulario de contacto (tabla solicitudes). Puede ser el MISMO proyecto Supabase
# que ya usa "El Club de la Ingeniería", o uno nuevo propio de Ethos IA.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Secreto compartido con el bot de WhatsApp (ethos-ia-whatsapp-bot). El bot lo
# manda en el header X-Internal-Key en cada llamada a /api/join y
# /api/empresa-chat, así este sitio puede darle su propio cupo de rate limit
# en vez de compartir el mismo cupo por IP que el resto de visitantes
# anónimos. Debe ser EL MISMO valor que INTERNAL_API_KEY en el .env del bot.
# Opcional: si no la configuras, el sitio sigue funcionando igual que antes
# (todo el tráfico se trata como público).
INTERNAL_API_KEY=

# Sitio y analítica
NEXT_PUBLIC_SITE_URL=https://www.ethosia.tech
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Nota: si tu .env.local trae además NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY o JOOBLE_API_KEY, son variables heredadas de
# cuando se copió el .env.local del Club de la Ingeniería para las pruebas en
# vivo de este proyecto — ningún archivo de este repo las usa hoy. Puedes
# borrarlas sin que nada se rompa.
